{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./src",
    "rootDir": "./src",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noEmit": false,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"]
  },
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "__mocks__",
    "**/*.d.ts"
  ]
}
