{
  "name": "@automattic/vip-go",
  "version": "1.4.1-dev.0",
  "description": "Node package helpers for the VIP Go platform",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "default": "./dist/src/types/index.js"
    }
  },
  "files": [
    "dist/src/"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "cmd:format": "prettier '**/*.(js|json|jsx|md|ts|tsx|yml|yaml)'",
    "cmd:lint": "eslint --ext 'js,jsx,ts,tsx'",
    "format": "npm run cmd:format -- --write",
    "format:check": "npm run cmd:format -- --check",
    "cmd:test": "node --require ts-node/register --experimental-test-module-mocks --test __tests__/*.spec.ts",
    "lint": "npm run cmd:lint .",
    "lint:fix": "npm run cmd:lint . -- --fix",
    "prepare": "npm run build",
    "test": "npm run lint && npm run typecheck && npm run cmd:test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">= 22.15.0",
    "npm": ">= 10.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automattic/vip-go-node.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Automattic/vip-go-node/issues"
  },
  "homepage": "https://github.com/Automattic/vip-go-node#readme",
  "dependencies": {
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "1.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "express": "^5.1.0",
    "ioredis": "^5.8.0",
    "prettier": "npm:wp-prettier@3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "winston-transport": "^4.9.0"
  }
}
